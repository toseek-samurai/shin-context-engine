{
  "schemaVersion": "shin.portable-distribution.v1",
  "document": "shin-portable-distribution-v1",
  "status": "accepted",
  "release": "2.0.4",
  "summary": "The default CMake install is a relocatable consumer-neutral Shin distribution with no neighboring repository or integration-profile dependency.",
  "layout": {
    "binary": "bin/shin-context",
    "version": "share/shin-context/VERSION",
    "profileDirectory": "share/shin-context/profiles",
    "contractDirectory": "share/shin-context/contracts",
    "codexSkillDirectory": "share/shin-context/codex/skills/shin-context",
    "hermesPluginDirectory": "share/shin-context/hermes/plugins/shin-context",
    "thirdPartyLicenses": [
      "licenses/nlohmann/LICENSE.MIT",
      "licenses/simdjson/LICENSE-APACHE-2.0",
      "licenses/simdjson/LICENSE-MIT",
      "licenses/tree-sitter/LICENSE",
      "licenses/tree-sitter/UPSTREAM.json",
      "licenses/tree-sitter/unicode/LICENSE",
      "licenses/tree-sitter-java/LICENSE",
      "licenses/tree-sitter-java/UPSTREAM.json",
      "licenses/tree-sitter-typescript/LICENSE",
      "licenses/tree-sitter-typescript/UPSTREAM.json",
      "licenses/tree-sitter-cpp/LICENSE",
      "licenses/tree-sitter-cpp/UPSTREAM.json",
      "licenses/pugixml/LICENSE.MIT",
      "licenses/pugixml/UPSTREAM.json"
    ],
    "genericProfiles": [
      "profiles/generic-cpp.json",
      "profiles/generic-docs.json",
      "profiles/generic-dotnet.json",
      "profiles/generic-java.json",
      "profiles/generic-kotlin.json",
      "profiles/generic-node.json",
      "profiles/generic-retool.json",
      "profiles/generic-source.json"
    ],
    "machineContracts": [
      "contracts/adoption-planner-v1.json",
      "contracts/agent-readiness-v1.json",
      "contracts/aggregate-validation-v1.json",
      "contracts/agent-context-pack-diff-v1.json",
      "contracts/agent-context-pack-v1.json",
      "contracts/batch-retrieval-v1.json",
      "contracts/cold-start-bootstrap-v1.json",
      "contracts/evidence-provenance-v1.json",
      "contracts/federated-brief-v1.json",
      "contracts/federated-eval-v1.json",
      "contracts/hermes-agent-integration-v1.json",
      "contracts/identifier-evidence-v1.json",
      "contracts/index-lifecycle-v1.json",
      "contracts/portable-distribution-v1.json",
      "contracts/project-adoption-v1.json",
      "contracts/profile-routing-v1.json",
      "contracts/retrieval-diagnose-v1.json",
      "contracts/retrieval-evidence-v1.json",
      "contracts/lexical-retrieval-v1.json",
      "contracts/retrieval-observation-v1.json",
      "contracts/retool-source-extractor-v1.json",
      "contracts/snapshot-diff-v1.json",
      "contracts/universality-boundary-v1.json",
      "contracts/worktree-diff-v1.json",
      "contracts/session-checkpoint-v1.json",
      "contracts/execution-evidence-v1.json",
      "contracts/trust-boundary-hardening-v1.json",
      "contracts/execution-receipt-v1.json",
      "contracts/change-aware-impact-pack-v1.json",
      "contracts/source-member-ranges-v1.json",
      "contracts/source-read-v1.json",
      "contracts/source-file-read-v1.json"
    ]
  },
  "install": {
    "configure": "cmake -S . -B build-cmake -DCMAKE_BUILD_TYPE=Release",
    "build": "cmake --build build-cmake --parallel",
    "stage": "cmake --install build-cmake --prefix /chosen/prefix",
    "runtimeProfileDir": "/chosen/prefix/share/shin-context/profiles",
    "defaultContents": "Core runtime, bootstrap assets, machine contracts, Codex skill, Hermes adapter plugin, and required third-party license notices only."
  },
  "relocation": {
    "supported": true,
    "rule": "The installed binary and data files do not retain the build source root or installation prefix as a runtime dependency.",
    "verification": "portable-install-check moves the staged prefix before invoking the installed binary and imports/checks external execution-evidence artifacts after relocation."
  },
  "nativeCompanions": {
    "layout": "Observer CMake install provides the local CLI and optional MCP/Monitor kit. It does not enroll projects or install credentials.",
    "verification": "observer/installer/package_smoke.py qualifies the extracted macOS archive, relocation, disposable installation, local retrieval and EN/RU terminal monitoring.",
    "releaseOwner": "docs/machine/shin-release-closure-v1.json",
    "optionalCoreAllocator": {
      "selection": "CMake SHIN_CORE_ALLOCATOR=mimalloc",
      "default": "system",
      "scope": "Non-sanitized standalone Linux Core CLI only; never the embeddable Core library, Observer or macOS.",
      "version": "3.5.3",
      "pin": "shared/cmake/CoreAllocator.cmake",
      "transparentHugePages": false,
      "runtimePreloadRequired": false,
      "installedPolicy": "share/shin-context/shin-core-allocator.json",
      "license": "share/shin-context/licenses/mimalloc/LICENSE",
      "approval": "Owner approved an isolated Linux candidate on2026-10-02, not Stable installation or release approval."
    },
    "status": "development-preview",
    "externalDependencies": "Observer requires OpenSSL Crypto. The macOS local kit bundles its runtime Crypto dependency and license; source builds require provisioned platform libraries."
  },
  "executionEvidence": {
    "contract": "contracts/execution-evidence-v1.json",
    "receiptContract": "contracts/execution-receipt-v1.json",
    "externalState": "Input requests, captured input manifests and receipt bundles remain outside the consumer and generated index. The explicitly named report may be inside a consumer test-output directory; its path and payload are not retained.",
    "readOnly": true,
    "testExecution": false,
    "payloadRetention": false
  },
  "integrationPolicy": {
    "installedByDefault": false,
    "sourceRegistry": "integrations",
    "profiles": "Permanent consumer profiles and federation configuration remain opt-in source-repository integration bundles.",
    "consumerRepositoriesRequired": false
  },
  "acceptance": {
    "gate": "make portable-install-check",
    "reportSchema": "shin.portable-install-check.v1",
    "runtimeFlow": [
      "version",
      "discover",
      "adoption-plan",
      "adoption-check",
      "profile-check",
      "build",
      "check",
      "doctor",
      "eval",
      "pack-eval",
      "validate",
      "suggest-profile",
      "ready",
      "brief",
      "pack",
      "receipt-scope",
      "receipt-import",
      "receipt-check",
      "checkpoint",
      "resume",
      "impact",
      "index-list",
      "index-prune dry-run",
      "index-prune apply"
    ],
    "projectMutationRequired": false,
    "sourceTreeRequiredAfterInstall": false
  }
}
