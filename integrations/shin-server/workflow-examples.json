{
  "schemaVersion": "shin.headless-workflow-examples.v1",
  "notice": "Examples, not an executable plan or permission grant. Replace identities and obtain revisions/times from the reviewed binding and current responses. Keep complete mutation bodies for exact retries.",
  "project": {
    "id": "workflow-project",
    "display_name": "Workflow project"
  },
  "workspace": {
    "id": "primary",
    "display_name": "Primary",
    "root": "/absolute/reviewed/source"
  },
  "prepare": {
    "expected_snapshot_id": null
  },
  "activate": {
    "preparation_id": 1,
    "expected_revision": 0
  },
  "refresh": {},
  "bootstrap": {
    "schema_version": "shin.session-bootstrap-request.v2",
    "task_id": "host-task",
    "members": [
      {
        "project_id": "workflow-project",
        "selector": {
          "kind": "route",
          "id": "workflow-route"
        },
        "query": "publication authorization",
        "required": true
      }
    ],
    "max_evidence_bytes": 16384
  },
  "draft": {
    "schema_version": "shin.session-draft.v1",
