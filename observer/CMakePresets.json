{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "windows-desktop",
      "displayName": "Windows x64 Observer, MCP and Monitor source build",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "$env{SHIN_BUILD_ROOT}/desktop",
      "condition": {
        "type": "allOf",
        "conditions": [
          { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
          { "type": "notEquals", "lhs": "$env{SHIN_BUILD_ROOT}", "rhs": "" }
        ]
      },
      "cacheVariables": {
        "BUILD_TESTING": true,
        "SHIN_OBSERVER_SOURCE_DISCOVERY": true,
        "SHIN_OBSERVER_MCP": true,
        "SHIN_OBSERVER_TRAY": true,
        "SHIN_OBSERVER_LOCAL_KIT": false,
        "SHIN_OBSERVER_WINDOWS_KIT": false
      }
    }
  ],
  "buildPresets": [
    { "name": "windows-desktop", "configurePreset": "windows-desktop", "configuration": "Release", "jobs": 4 }
  ],
  "testPresets": [
    {
      "name": "windows-desktop",
      "configurePreset": "windows-desktop",
      "configuration": "Release",
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error", "jobs": 2 }
    },
    {
      "name": "windows-desktop-smoke",
      "inherits": "windows-desktop",
      "filter": {
        "include": {
          "name": "^(shin-ui-(language|terminal-language|catalog)|shin-platform-boundaries|shin-windows-(build-placement|file|scm-transport)|shin-context-source-discovery|shin-observer-(protocol|windows-(storage|runtime|project|worker))|shin-local-(startup|release|mcp-scope|rpc|session-analysis|mcp-activity|history-files|history-recovery|changes|worker-process|refresh-races)|shin-native-install|shin-tray-(diagnostics|request-timing))$"
        }
      }
    }
  ]
}
