# Select public guidance inputs explicitly; never package an unreviewed directory.
function(shin_package_agent_skill client source)
    set(destination "share/shin-observer/agent-skills/${client}")
    set(output "${CMAKE_CURRENT_BINARY_DIR}/${destination}")
    file(REMOVE_RECURSE "${output}")
    set(manifest "{\"schema_version\":\"shin.${client}-skill-bundle.v1\",\"name\":\"shin-context\",\"version\":\"${SHIN_OBSERVER_VERSION}\",\"files\":{")
    set(separator "")
    foreach(relative IN LISTS ARGN)
        if(relative MATCHES "(^/|(^|/)\\.\\.(/|$)|[\\\"\n\r])" OR NOT relative MATCHES "\\.(md|yaml)$")
            message(FATAL_ERROR "Invalid public agent skill path: ${relative}")
        endif()
        set(input "${source}/${relative}")
        file(SHA256 "${input}" checksum)
        configure_file("${input}" "${output}/shin-context/${relative}" COPYONLY)
        string(APPEND manifest "${separator}\"${relative}\":\"${checksum}\"")
        set(separator ",")
    endforeach()
    string(APPEND manifest "}}\n")
    file(WRITE "${output}/bundle.json" "${manifest}")
    install(DIRECTORY "${output}/" DESTINATION "${destination}")
endfunction()

get_filename_component(shin_integrations "${SHIN_OBSERVER_ROOT}/../integrations" ABSOLUTE)
set(shin_skill_spec "${shin_integrations}/codex/skill-bundle.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${shin_skill_spec}")
file(READ "${shin_skill_spec}" shin_skill_spec_json)
string(JSON shin_skill_count LENGTH "${shin_skill_spec_json}" files)
math(EXPR shin_skill_last "${shin_skill_count}-1")
set(shin_codex_skill_files "")
foreach(index RANGE 0 ${shin_skill_last})
    string(JSON relative GET "${shin_skill_spec_json}" files ${index})
    list(APPEND shin_codex_skill_files "${relative}")
endforeach()
shin_package_agent_skill(codex "${shin_integrations}/codex/skills/shin-context" ${shin_codex_skill_files})
shin_package_agent_skill(claude "${shin_integrations}/mcp/skills/shin-context" SKILL.md)
