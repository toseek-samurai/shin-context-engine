# Select public guidance inputs explicitly; never package an unreviewed directory.
get_filename_component(shin_skill_source "${SHIN_OBSERVER_ROOT}/../integrations/codex" ABSOLUTE)
set(shin_skill_spec "${shin_skill_source}/skill-bundle.json")
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${shin_skill_spec}")
file(READ "${shin_skill_spec}" shin_skill_spec_json)
string(JSON shin_skill_count LENGTH "${shin_skill_spec_json}" files)
math(EXPR shin_skill_last "${shin_skill_count}-1")
set(shin_skill_output "${CMAKE_CURRENT_BINARY_DIR}/share/shin-observer/agent-skills/codex")
file(REMOVE_RECURSE "${shin_skill_output}")
set(shin_skill_manifest "{\"schema_version\":\"shin.codex-skill-bundle.v1\",\"name\":\"shin-context\",\"version\":\"${SHIN_OBSERVER_VERSION}\",\"files\":{")
foreach(index RANGE 0 ${shin_skill_last})
    string(JSON relative GET "${shin_skill_spec_json}" files ${index})
    if(relative MATCHES "(^/|(^|/)\\.\\.(/|$)|[\\\"\n\r])" OR NOT relative MATCHES "\\.(md|yaml)$")
        message(FATAL_ERROR "Invalid public Codex skill path: ${relative}")
    endif()
    set(input "${shin_skill_source}/skills/shin-context/${relative}")
    file(SHA256 "${input}" checksum)
    configure_file("${input}" "${shin_skill_output}/shin-context/${relative}" COPYONLY)
    if(index GREATER 0)
        string(APPEND shin_skill_manifest ",")
    endif()
    string(APPEND shin_skill_manifest "\"${relative}\":\"${checksum}\"")
endforeach()
string(APPEND shin_skill_manifest "}}\n")
file(WRITE "${shin_skill_output}/bundle.json" "${shin_skill_manifest}")
install(DIRECTORY "${shin_skill_output}/" DESTINATION share/shin-observer/agent-skills/codex)
