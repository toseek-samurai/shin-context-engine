set(kit "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${kit}" "${kit}/*")
list(REMOVE_ITEM files "shin-updater.json")
list(SORT files)
set(updater "{\"schema_version\":\"shin.updater.v1\",\"protocol\":1,\"version\":\"@SHIN_OBSERVER_VERSION@\",\"files\":[")
set(separator "")
foreach(path IN LISTS files)
    if(path STREQUAL "bin/shin-updater" OR path MATCHES "^bin/[^/]+[.]dylib$" OR
        (path MATCHES "^share/" AND (path MATCHES "/licenses/" OR path MATCHES "/(LICENSE|NOTICE)([.]txt)?$")))
        file(SHA256 "${kit}/${path}" hash)
        file(SIZE "${kit}/${path}" bytes)
        set(executable false)
        if(path STREQUAL "bin/shin-updater")
            set(executable true)
        endif()
        string(APPEND updater "${separator}{\"path\":\"${path}\",\"sha256\":\"${hash}\",\"size\":${bytes},\"executable\":${executable}}")
        set(separator ",")
    endif()
endforeach()
string(APPEND updater "]}\n")
file(WRITE "${kit}/shin-updater.json" "${updater}")
list(APPEND files "shin-updater.json")
set(manifest "{\"schema_version\":\"shin.local-kit.v1\",\"version\":\"@SHIN_OBSERVER_VERSION@\",\"core_version\":\"@SHIN_KIT_CORE_VERSION@\",\"files\":[")
set(separator "")
foreach(path IN LISTS files)
    if(path STREQUAL "shin-kit.json")
        continue()
    endif()
    if(IS_SYMLINK "${kit}/${path}" OR path MATCHES "[\\\";\n\r]")
        message(FATAL_ERROR "Unsafe kit path: ${path}")
    endif()
    file(SHA256 "${kit}/${path}" sha256)
    file(SIZE "${kit}/${path}" size)
    set(executable false)
    if(path MATCHES "^bin/shin-(context|observer|ce|mcp|usage|tray|updater)([.]exe)?$" OR path STREQUAL "Shin Monitor.app/Contents/MacOS/Shin Monitor")
        set(executable true)
    endif()
    string(APPEND manifest "${separator}{\"path\":\"${path}\",\"sha256\":\"${sha256}\",\"size\":${size},\"executable\":${executable}}")
    set(separator ",")
endforeach()
string(APPEND manifest "]}\n")
file(WRITE "${kit}/shin-kit.json" "${manifest}")
