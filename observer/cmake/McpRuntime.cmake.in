# Run after dependency fixups and before the outer package inventory. The bridge
# cohort contains code/libraries and component versions, never project inputs.
set(prefix "$ENV{DESTDIR}${CMAKE_INSTALL_PREFIX}")
file(GLOB_RECURSE files LIST_DIRECTORIES false RELATIVE "${prefix}" "${prefix}/bin/*")
list(APPEND files "share/shin-context/VERSION" "share/shin-observer/VERSION")
list(SORT files)
set(manifest "{\"schema_version\":\"shin.mcp-service.v1\",\"adapter_contract_sha256\":\"@SHIN_MCP_ADAPTER_CONTRACT@\",\"observer_version\":\"@SHIN_OBSERVER_VERSION@\",\"core_version\":\"@SHIN_MCP_CORE_VERSION@\",\"files\":[")
set(separator "")
foreach(path IN LISTS files)
    if(IS_SYMLINK "${prefix}/${path}" OR path MATCHES "[\\\";\n\r]")
        message(FATAL_ERROR "Unsafe MCP runtime path: ${path}")
    endif()
    file(SHA256 "${prefix}/${path}" hash)
    file(SIZE "${prefix}/${path}" bytes)
    string(APPEND manifest "${separator}{\"path\":\"${path}\",\"sha256\":\"${hash}\",\"size\":${bytes}}")
    set(separator ",")
endforeach()
string(APPEND manifest "]}\n")
file(MAKE_DIRECTORY "${prefix}/share/shin-context")
file(WRITE "${prefix}/share/shin-context/mcp-runtime.json" "${manifest}")
