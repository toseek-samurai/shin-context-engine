include("${SHIN_OBSERVER_ROOT}/../shared/cmake/Http.cmake")
set(SHIN_NATIVE_SOURCES config io_json observation observer outbox metrics delivery_config delivery_transport delivery source_query source_view)
if(WIN32)
    list(APPEND SHIN_NATIVE_SOURCES io_windows)
    set(SHIN_NATIVE_WARNINGS /W4 /WX /permissive- /utf-8)
else()
    find_package(OpenSSL REQUIRED COMPONENTS Crypto)
    list(APPEND SHIN_NATIVE_SOURCES io)
    set(SHIN_NATIVE_WARNINGS -Wall -Wextra -Wpedantic -Wmissing-declarations)
endif()
if(SHIN_OBSERVER_SOURCE_DISCOVERY)
    list(APPEND SHIN_NATIVE_SOURCES local_project local_publication local_service local_rpc local_registry local_profile_location
