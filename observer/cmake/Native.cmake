# Single product source list, used by standalone Observer and embedded Core builds.
get_filename_component(SHIN_OBSERVER_ROOT "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
file(STRINGS "${SHIN_OBSERVER_ROOT}/VERSION" SHIN_OBSERVER_VERSION LIMIT_COUNT 1)
if(NOT SHIN_OBSERVER_VERSION MATCHES "^((0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*))(-(dev|rc)\\.(0|[1-9][0-9]*))?$")
    message(FATAL_ERROR "Observer VERSION must identify a canonical release or candidate")
endif()
set(SHIN_OBSERVER_STABILITY stable)
if(SHIN_OBSERVER_VERSION MATCHES "-(dev|rc)\\.")
    set(SHIN_OBSERVER_STABILITY development)
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${SHIN_OBSERVER_ROOT}/VERSION")
