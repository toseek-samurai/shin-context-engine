# Windows Installer compares three numeric fields (255.255.65535 at most).
# Keep preview ordering within each patch: dev < rc < stable < next patch.
set(SHIN_WINDOWS_UPGRADE_GUID "4D5D4627-1B39-4F4A-ABEE-17CE51649F28")
function(shin_windows_package_identity input version_output product_output)
    if(NOT "${input}" MATCHES "^([0-9]+)[.]([0-9]+)[.]([0-9]+)(-(dev|rc)[.]([0-9]+))?$")
        message(FATAL_ERROR "Unsupported Windows package version: ${input}")
    endif()
    set(major "${CMAKE_MATCH_1}")
    set(minor "${CMAKE_MATCH_2}")
    set(patch "${CMAKE_MATCH_3}")
    set(channel "${CMAKE_MATCH_5}")
    set(serial "${CMAKE_MATCH_6}")
    foreach(number IN ITEMS "${major}" "${minor}" "${patch}" "${serial}")
        if(number STREQUAL "")
            continue()
        endif()
        string(LENGTH "${number}" length)
        if(length GREATER 3 OR NOT number MATCHES "^(0|[1-9][0-9]*)$")
            message(FATAL_ERROR "Unsupported Windows package version: ${input}")
        endif()
    endforeach()
    if(major GREATER 255 OR minor GREATER 255 OR patch GREATER 64)
        message(FATAL_ERROR "Windows package policy requires major/minor <=255 and patch <=64: ${input}")
    endif()
    set(offset 999)
    if(channel STREQUAL "dev")
        if(serial GREATER 899)
            message(FATAL_ERROR "Windows package policy requires dev serial <=899: ${input}")
        endif()
        set(offset "${serial}")
    elseif(channel STREQUAL "rc")
        if(serial GREATER 98)
            message(FATAL_ERROR "Windows package policy requires rc serial <=98: ${input}")
        endif()
        math(EXPR offset "900 + ${serial}")
    endif()
    math(EXPR build "${patch} * 1000 + ${offset}")
    string(UUID product NAMESPACE "${SHIN_WINDOWS_UPGRADE_GUID}"
        NAME "windows-x64:${input}" TYPE SHA1 UPPER)
    set(${version_output} "${major}.${minor}.${build}" PARENT_SCOPE)
    set(${product_output} "${product}" PARENT_SCOPE)
endfunction()
