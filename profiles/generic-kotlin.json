  "jsonKeyMaxDepth": 2,
  "jsonKeyMaxSectionsPerFile": 80,
  "jsonlMaxRowsPerFile": 2000,
  "sortTopics": true,
  "defaultTopic": "kotlin-source",
  "evalCases": [],
  "topicRules": [
    {
      "id": "kotlin-source",
      "description": "Kotlin packages, classes, interfaces, objects, type aliases, functions, and tests.",
      "keywords": ["kotlin", "package", "class", "interface", "object", "typealias", "function"]
    },
    {
      "id": "build",
      "description": "Gradle and Kotlin DSL project structure.",
      "keywords": ["gradle", "build.gradle.kts", "settings.gradle.kts", "kotlin dsl"]
    },
    {
      "id": "tests",
      "description": "Kotlin test source evidence.",
      "keywords": ["test", "junit", "kotest", "src/test"]
