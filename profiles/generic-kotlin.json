  "id": "generic-kotlin",
  "sourceLabel": "Kotlin bootstrap source evidence",
  "rootFiles": [],
  "optionalRootFiles": [
    "README.md",
    "readme.md",
    "AGENTS.md",
    "build.gradle",
    "build.gradle.kts",
    "settings.gradle",
    "settings.gradle.kts",
    "gradle.properties"
