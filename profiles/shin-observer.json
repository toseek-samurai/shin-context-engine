              "query": "capture_outbox"
            }
          ]
        },
        "budget": {
          "max_evidence_bytes": 24576,
          "max_records": 16,
          "per_query_records": 6,
          "per_document_records": 3
        }
      },
      "mustPaths": [
        "docs/machine/shin-observer-outbox-v1.json",
        "observer/src/observation.cpp",
        "observer/src/observer.cpp",
        "observer/src/outbox.cpp"
