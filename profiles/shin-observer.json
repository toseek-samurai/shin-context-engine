      "request": {
        "schema_version": "shin.task-request.v1",
        "request_id": "observer-local-proof",
        "task": {
          "objective": "Inspect local-only Observer source freshness, atomic outbox and state continuity without claiming network synchronization.",
          "must": [
            {
              "id": "contract",
              "query": "shin-observer-outbox-v1"
            },
            {
