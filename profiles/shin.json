  "packEvalCases": [
    {
      "id": "self-agent-operations-pack",
      "request": {
        "schema_version": "shin.task-request.v1",
        "request_id": "self-agent-operations-pack",
        "task": {
          "objective": "Retrieve the implementation and contracts for Shin Agent Context Pack operations.",
          "scope": [
            {
              "id": "pack-contract",
              "query": "agent-context-pack-v1"
            }
          ],
          "must": [
            {
              "id": "pack-selection",
              "query": "pack_active_jobs"
            },
            {
              "id": "pack-projection",
              "query": "pack_telemetry_json"
            },
            {
              "id": "pack-quality",
              "query": "run_pack_eval"
            }
          ],
          "should": [
            {
              "id": "pack-performance",
              "query": "run_pack_bench"
            },
            {
              "id": "release-gates",
              "query": "Agent Context Pack release gates sanitizer skill contract"
            }
          ]
        },
        "budget": {
          "max_evidence_bytes": 24576,
          "max_records": 16,
          "per_query_records": 6,
          "per_document_records": 2
        }
      },
      "mustPaths": [
        "docs/machine/agent-context-pack-v1.json",
        "src/agent_context_pack.cpp",
        "src/agent_context_pack_render.cpp",
        "src/pack_eval.cpp",
        "src/pack_bench.cpp"
      ],
      "mustNotPaths": [
        "profiles/shin-server.json"
      ],
      "expectedComplete": true,
      "maxEvidenceBytes": 24576,
      "maxRecords": 16,
      "maxCompactBytes": 38000,
      "requireSerialParallelIdentity": true
    }
  ],
