# MSBuild FileTracker deliberately excludes AppData and temporary files from
# dependencies. A successful incremental build there can contain stale headers.
if(MSVC AND CMAKE_GENERATOR MATCHES "^Visual Studio")
    set(shin_excluded_build_roots "$ENV{LOCALAPPDATA}" "$ENV{APPDATA}" "$ENV{TEMP}" "$ENV{TMP}")
    if(DEFINED ENV{USERPROFILE})
        list(APPEND shin_excluded_build_roots "$ENV{USERPROFILE}/AppData/LocalLow")
    endif()
    foreach(root IN LISTS shin_excluded_build_roots)
        if(root STREQUAL "")
            continue()
        endif()
        file(TO_CMAKE_PATH "${root}" normalized)
        get_filename_component(normalized "${normalized}" REALPATH)
        string(TOUPPER "${normalized}" normalized)
        foreach(path IN ITEMS "${CMAKE_SOURCE_DIR}" "${CMAKE_BINARY_DIR}")
            get_filename_component(candidate "${path}" REALPATH)
            string(TOUPPER "${candidate}" candidate)
            string(FIND "${candidate}/" "${normalized}/" prefix)
            if(prefix EQUAL 0)
                message(FATAL_ERROR "MSBuild cannot reliably track Shin under AppData/TEMP. Move source and build outside these directories, e.g. USERPROFILE/ShinBuild.")
            endif()
        endforeach()
    endforeach()
endif()
