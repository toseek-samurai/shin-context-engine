  "packEvalCases": [
    {
      "id": "fixture-agent-context-pack",
      "request": {
        "schema_version": "shin.task-request.v1",
        "request_id": "fixture-agent-context-pack",
        "task": {
          "objective": "Load fixture contracts, operations, and source facts.",
          "scope": [
            {"id": "capability", "query": "capability contract"}
          ],
          "must": [
            {"id": "result", "query": "result contract"},
            {"id": "rollback", "query": "rollback runbook"}
          ],
          "should": [
            {"id": "widget", "query": "triggerWidget arrow-function"}
          ]
        },
        "budget": {
          "max_evidence_bytes": 24000,
          "max_records": 12,
          "per_query_records": 6,
          "per_document_records": 2
        }
      },
      "mustPaths": [
        "docs/architecture.md",
        "docs/operations.md"
      ],
      "mustNotPaths": [
        "docs/excluded/ignored.md"
      ],
      "expectedComplete": true,
      "maxEvidenceBytes": 24000,
      "maxRecords": 12,
      "maxCompactBytes": 30000,
      "requireSerialParallelIdentity": true
    },
